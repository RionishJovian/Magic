[Unit]
Description=MikroMagic VPS health monitor
After=network-online.target docker.service mikromagic-app.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/mikromagic-monitor.env
ExecStart=/usr/local/sbin/mikromagic-health-monitor
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mikromagic-monitor

